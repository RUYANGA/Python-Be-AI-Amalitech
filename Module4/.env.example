# ─── MongoDB Connection ─────────────────────────────
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=social_media
MONGO_USERNAME=
MONGO_PASSWORD=
MONGO_AUTH_SOURCE=admin

# ─── PostgreSQL Connection (primary store + post metadata) ──
PG_HOST=localhost
PG_PORT=5432
PG_DB=social_media
PG_USER=postgres
PG_PASSWORD=
PG_POOL_MIN=1
PG_POOL_MAX=10

# ─── Redis Connection (timeline cache) ──────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ─── Security ───────────────────────────────────────
# Used for hashing user passwords (bcrypt work factor)
BCRYPT_ROUNDS=12
APP_SECRET_KEY=change-me-to-a-long-random-string

# ─── App ────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
