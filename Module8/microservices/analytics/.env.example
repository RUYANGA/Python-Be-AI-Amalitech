DEBUG=True
SECRET_KEY=change-me-analytics

DB_NAME=analytics
DB_USER=analytics
DB_PASSWORD=change-me

# Must match the shortener service's INTERNAL_SERVICE_TOKEN.
INTERNAL_SERVICE_TOKEN=change-me-internal-token

# Where to look up URL ownership — called directly, not through the API
# gateway (../../gateway is for client-facing traffic only). Defaults to
# http://shortener:8000 under Docker Compose; override for local
# runserver use.
# SHORTENER_SERVICE_URL=http://localhost:8002

# Broker for the write-behind click-ingestion task. Defaults to a
# *different Redis DB* than REDIS_URL above, and different from
# shortener's own broker DB — see the comment on CELERY_BROKER_URL in
# settings.py for why sharing one is unsafe.
# CELERY_BROKER_URL=redis://127.0.0.1:6379/2
