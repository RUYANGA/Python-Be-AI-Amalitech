# ─── General Settings ─────────────────────
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0

# ─── PostgreSQL Database ──────────────────
DB_ENGINE=django.db.backends.postgresql
DB_NAME=url_shortener
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# ─── Redis Cache ──────────────────────────
REDIS_URL=redis://127.0.0.1:6379/0
