DEBUG=True
SECRET_KEY=change-me-shortener

DB_NAME=shortener
DB_USER=shortener
DB_PASSWORD=change-me

# Shared static secret for the internal ownership-lookup endpoint that
# the analytics service calls. Needs to match on both sides.
INTERNAL_SERVICE_TOKEN=change-me-internal-token

# Where to publish click events — called directly, not through the API
# gateway (../../gateway is for client-facing traffic only). Defaults to
# http://analytics:8000 under Docker Compose; override for local
# runserver use.
# ANALYTICS_SERVICE_URL=http://localhost:8003
