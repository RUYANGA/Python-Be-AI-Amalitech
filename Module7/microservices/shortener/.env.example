DEBUG=True
SECRET_KEY=change-me-shortener

DB_NAME=shortener
DB_USER=shortener
DB_PASSWORD=change-me

# Shared static secret for the internal ownership-lookup endpoint that
# the analytics service calls. Needs to match on both sides.
INTERNAL_SERVICE_TOKEN=change-me-internal-token

# Where to reach a running auth service to verify JWTs, and analytics
# to publish click events — both over REST.
# AUTH_SERVICE_URL=http://host.docker.internal:8001
# ANALYTICS_SERVICE_URL=http://host.docker.internal:8003
