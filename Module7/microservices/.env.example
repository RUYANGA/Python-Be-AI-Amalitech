DEBUG=True

AUTH_SECRET_KEY=change-me-auth
SHORTENER_SECRET_KEY=change-me-shortener
ANALYTICS_SECRET_KEY=change-me-analytics

# Shared static secret for the shortener<->analytics internal ownership
# lookup. Not a JWT, not user-facing — just needs to match on both sides.
INTERNAL_SERVICE_TOKEN=change-me-internal-token

AUTH_DB_NAME=auth
AUTH_DB_USER=auth
AUTH_DB_PASSWORD=change-me

SHORTENER_DB_NAME=shortener
SHORTENER_DB_USER=shortener
SHORTENER_DB_PASSWORD=change-me

ANALYTICS_DB_NAME=analytics
ANALYTICS_DB_USER=analytics
ANALYTICS_DB_PASSWORD=change-me
