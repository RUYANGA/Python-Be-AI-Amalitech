DEBUG=True
SECRET_KEY=change-me-analytics

DB_NAME=analytics
DB_USER=analytics
DB_PASSWORD=change-me

# Must match the shortener service's INTERNAL_SERVICE_TOKEN.
INTERNAL_SERVICE_TOKEN=change-me-internal-token

# Where to reach a running auth service to verify JWTs, and shortener
# for ownership lookups — both over REST (host.docker.internal when
# running either standalone compose on the same host).
# AUTH_SERVICE_URL=http://host.docker.internal:8001
# SHORTENER_SERVICE_URL=http://host.docker.internal:8002
