DEBUG=True
SECRET_KEY=change-me-analytics

DB_NAME=analytics
DB_USER=analytics
DB_PASSWORD=change-me

# Must match the shortener service's INTERNAL_SERVICE_TOKEN.
INTERNAL_SERVICE_TOKEN=change-me-internal-token

# Where to reach a running shortener service for ownership lookups —
# its gRPC server (shortener-grpc:50051 in compose, host.docker.internal
# when running the shortener standalone compose on the same host).
# SHORTENER_GRPC_URL=host.docker.internal:50051
