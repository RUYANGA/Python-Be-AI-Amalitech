DEBUG=True
# Explicit allowed Host values (comma-separated) — the '*' wildcard is not permitted.
ALLOWED_HOSTS=localhost,127.0.0.1
SECRET_KEY=change-me-auth

DB_NAME=auth
DB_USER=auth
DB_PASSWORD=change-me

# Shared static secret authenticating REST calls to this service's
# internal token-validation endpoint. Must match the shortener/analytics
# INTERNAL_SERVICE_TOKEN.
INTERNAL_SERVICE_TOKEN=change-me-internal-token
