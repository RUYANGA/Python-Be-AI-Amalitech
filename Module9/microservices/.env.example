DEBUG=True

# Explicit allowed Host values (comma-separated) — the '*' wildcard is not
# permitted. Include the Docker service names (services call each other over
# the internal network by hostname) plus localhost for the gateway's client
# traffic; extend with your machine's IP/domain if you reach it from elsewhere.
ALLOWED_HOSTS=localhost,127.0.0.1,auth,shortener,analytics,url-preview

AUTH_SECRET_KEY=change-me-auth
SHORTENER_SECRET_KEY=change-me-shortener
ANALYTICS_SECRET_KEY=change-me-analytics
URL_PREVIEW_SECRET_KEY=change-me-url-preview

# Shared static secret for internal service-to-service REST calls (token
# validation, ownership lookup, click ingestion, url preview fetch). Not
# a JWT, not user-facing — just needs to match on both sides.
INTERNAL_SERVICE_TOKEN=change-me-internal-token

# The gateway's allowed browser origin for CORS — a React (or other)
# frontend dev server, typically. See gateway/README.md#cors-frontend-interaction.
CORS_ALLOWED_ORIGIN=http://localhost:3000

# All four services connect to Postgres running on the HOST machine
# (via host.docker.internal), not a containerized database — one role,
# four separate databases. Create them once with e.g.:
#   createdb -U postgres auth shortener analytics url_preview
DB_USER=postgres
DB_PASSWORD=change-me

AUTH_DB_NAME=auth
SHORTENER_DB_NAME=shortener
ANALYTICS_DB_NAME=analytics
URL_PREVIEW_DB_NAME=url_preview

# Resiliency tuning for url-preview's fetch of destination pages — retry
# with exponential backoff, then a per-domain circuit breaker once a
# domain keeps failing. See url-preview/README.md.
# PREVIEW_FETCH_TIMEOUT=5.0
# PREVIEW_MAX_ATTEMPTS=3
# PREVIEW_RETRY_BASE_DELAY=0.5
# PREVIEW_MAX_BODY_BYTES=2000000
# PREVIEW_CIRCUIT_FAILURE_THRESHOLD=5
# PREVIEW_CIRCUIT_OPEN_SECONDS=60
# PREVIEW_CACHE_TTL=600
