DEBUG=True
SECRET_KEY=change-me-url-preview

DB_NAME=url_preview
DB_USER=url_preview
DB_PASSWORD=change-me

# Shared static secret for the internal preview-fetch endpoint that the
# shortener service calls. Needs to match on both sides.
INTERNAL_SERVICE_TOKEN=change-me-internal-token

# Backs the result cache and the per-domain circuit breaker.
# REDIS_URL=redis://127.0.0.1:6379/0

# ─── Preview-fetch tuning (defaults shown) ──────────────────────────
# PREVIEW_FETCH_TIMEOUT=5.0
# PREVIEW_MAX_ATTEMPTS=3
# PREVIEW_RETRY_BASE_DELAY=0.5
# PREVIEW_MAX_BODY_BYTES=2000000
# PREVIEW_CIRCUIT_FAILURE_THRESHOLD=5
# PREVIEW_CIRCUIT_OPEN_SECONDS=60
# PREVIEW_CACHE_TTL=600
